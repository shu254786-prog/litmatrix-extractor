page {
  background-color: #f8fafc;
  color: #0f172a;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

view, text, scroll-view, button, input {
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid #e2e8f0;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.03);
}

.btn-primary {
  background: #4f46e5;
  color: #ffffff;
  border-radius: 14rpx;
  font-weight: 600;
  font-size: 28rpx;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  background: #f1f5f9;
  color: #1e293b;
  border-radius: 14rpx;
  font-weight: 500;
  font-size: 26rpx;
  border: 1rpx solid #cbd5e1;
}

.btn-secondary::after {
  border: none;
}

.tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  background: #f1f5f9;
  color: #334155;
  margin-right: 10rpx;
  margin-bottom: 8rpx;
}

.tag-page {
  background: #fef3c7;
  color: #92400e;
  border: 1rpx solid #fcd34d;
  font-weight: 600;
}
