page {
  background-color: #F2F2F7;
  color: #000000;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display", "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.48;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

view, text, scroll-view, button, input, textarea {
  box-sizing: border-box;
}

/* Apple iOS Grouped Inset Card */
.ios-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.035);
  border: 1rpx solid rgba(60, 60, 67, 0.06);
}

.ios-group {
  background: #FFFFFF;
  border-radius: 22rpx;
  overflow: hidden;
  margin-bottom: 28rpx;
  box-shadow: 0 2rpx 14rpx rgba(0, 0, 0, 0.03);
}

.ios-cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx;
  background: #FFFFFF;
  position: relative;
}

.ios-cell-border::after {
  content: "";
  position: absolute;
  left: 28rpx;
  right: 0;
  bottom: 0;
  height: 1rpx;
  background: rgba(60, 60, 67, 0.12);
}

.ios-section-title {
  font-size: 24rpx;
  color: #8E8E93;
  text-transform: uppercase;
  letter-spacing: 1rpx;
  margin: 0 0 12rpx 24rpx;
  font-weight: 500;
}

/* Spring tactile press */
.ios-press {
  transform: scale(0.972) !important;
  opacity: 0.86 !important;
  transition: transform 0.15s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.15s ease !important;
}

/* Entrance animations */
@keyframes iosSlideFade {
  0% {
    opacity: 0;
    transform: translateY(22rpx) scale(0.985);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.ios-enter {
  animation: iosSlideFade 0.42s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.ios-enter-delay-1 { animation-delay: 0.05s; }
.ios-enter-delay-2 { animation-delay: 0.10s; }
.ios-enter-delay-3 { animation-delay: 0.15s; }

@keyframes iosSheetUp {
  0% {
    opacity: 0;
    transform: translateY(100%);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

.ios-sheet-up {
  animation: iosSheetUp 0.36s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes iosShimmer {
  0% { background-position: -400rpx 0; }
  100% { background-position: 400rpx 0; }
}

.ios-skeleton {
  background: linear-gradient(90deg, #E5E5EA 25%, #F2F2F7 50%, #E5E5EA 75%);
  background-size: 800rpx 100%;
  animation: iosShimmer 1.3s infinite linear;
  border-radius: 12rpx;
}

/* Primary & Secondary Apple Buttons */
.ios-btn-primary {
  background: linear-gradient(135deg, #007AFF 0%, #5856D6 100%);
  color: #FFFFFF;
  border-radius: 20rpx;
  font-weight: 600;
  font-size: 30rpx;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(0, 122, 255, 0.24);
  transition: transform 0.18s cubic-bezier(0.22, 1, 0.36, 1);
}

.ios-btn-primary::after {
  border: none;
}

.ios-btn-tinted {
  background: rgba(0, 122, 255, 0.1);
  color: #007AFF;
  border-radius: 18rpx;
  font-weight: 600;
  font-size: 27rpx;
  border: none;
}

.ios-btn-tinted::after {
  border: none;
}

.ios-pill {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
  background: #F2F2F7;
  color: #3A3A3C;
  margin-right: 10rpx;
  margin-bottom: 8rpx;
}

.ios-pill-cite {
  background: rgba(255, 149, 0, 0.12);
  color: #C96A00;
  font-weight: 600;
}
