.page-wrap {
  min-height: 100vh;
  padding-bottom: 160rpx;
}

.content {
  padding: 20rpx 24rpx;
}

.nav-user-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(60, 60, 67, 0.1);
  border-radius: 999rpx;
  padding: 6rpx 16rpx 6rpx 8rpx;
}

.nav-avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
}

.nav-user-text {
  font-size: 22rpx;
  font-weight: 600;
  color: #1C1C1E;
  max-width: 140rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.large-title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: -0.6rpx;
  color: #000000;
}

.status-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 6rpx;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.dot-green {
  background: #34C759;
  box-shadow: 0 0 0 4rpx rgba(52, 199, 89, 0.2);
}

.dot-amber {
  background: #FF9500;
  box-shadow: 0 0 0 4rpx rgba(255, 149, 0, 0.2);
}

.meta-txt {
  font-size: 23rpx;
  color: #8E8E93;
}

.count-badge {
  background: #F2F2F7;
  padding: 10rpx 18rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: baseline;
}

.count-num {
  font-size: 34rpx;
  font-weight: 700;
  color: #007AFF;
}

.count-sub {
  font-size: 22rpx;
  color: #8E8E93;
  margin-left: 2rpx;
}

.btn-stack {
  margin-top: 26rpx;
}

.pick-btn {
  width: 100%;
  padding: 22rpx 0;
  line-height: 1.3;
}

.secondary-row {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.sec-btn {
  flex: 1;
  padding: 16rpx 0;
  line-height: 1.3;
}

.btn-danger-tint {
  background: rgba(255, 59, 48, 0.1);
  color: #FF3B30;
}

.prog-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.prog-label {
  font-size: 26rpx;
  font-weight: 600;
}

.prog-pct {
  font-size: 26rpx;
  font-weight: 700;
  color: #007AFF;
}

.ios-progress-track {
  height: 12rpx;
  background: #E5E5EA;
  border-radius: 999rpx;
  overflow: hidden;
}

.ios-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #007AFF, #5856D6);
  border-radius: 999rpx;
  transition: width 0.35s cubic-bezier(0.22, 1, 0.36, 1);
}

.chips-scroll {
  margin-top: 18rpx;
  white-space: nowrap;
}

.chips-row {
  display: inline-flex;
  gap: 12rpx;
}

.file-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  background: #F2F2F7;
  color: #3A3A3C;
}

.chip-done {
  background: rgba(52, 199, 89, 0.12);
  color: #1C7C36;
}

.chip-extracting {
  background: rgba(0, 122, 255, 0.12);
  color: #0066D6;
}

.chip-error {
  background: rgba(255, 59, 48, 0.12);
  color: #D70015;
}

.chip-txt {
  max-width: 240rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.retry-btn {
  margin-top: 16rpx;
  width: 100%;
  padding: 14rpx 0;
  line-height: 1.3;
}

.sk-title { height: 34rpx; width: 70%; margin-bottom: 14rpx; }
.sk-sub { height: 24rpx; width: 45%; margin-bottom: 22rpx; }
.sk-line { height: 22rpx; width: 100%; margin-bottom: 12rpx; }
.sk-line.short { width: 65%; }

/* Animated iOS Segmented Control */
.seg-wrap {
  position: relative;
  display: flex;
  background: rgba(118, 118, 128, 0.12);
  border-radius: 18rpx;
  padding: 6rpx;
  margin-bottom: 22rpx;
}

.seg-slider {
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  width: calc(50% - 6rpx);
  height: calc(100% - 12rpx);
  background: #FFFFFF;
  border-radius: 14rpx;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
}

.seg-right {
  transform: translateX(100%);
}

.seg-btn {
  position: relative;
  z-index: 2;
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 26rpx;
  font-weight: 500;
  color: #3A3A3C;
  transition: color 0.2s ease;
}

.seg-active {
  color: #000000;
  font-weight: 600;
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 14rpx;
}

.paper-title {
  font-size: 31rpx;
  font-weight: 700;
  color: #000000;
  flex: 1;
  line-height: 1.35;
}

.demo-tag {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 149, 0, 0.14);
  color: #C96A00;
}

.paper-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #007AFF;
  font-weight: 500;
}

.dim-block {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(60, 60, 67, 0.1);
}

.dim-item {
  margin-bottom: 14rpx;
}

.dim-k {
  display: inline-block;
  font-size: 21rpx;
  font-weight: 600;
  color: #5856D6;
  background: rgba(88, 86, 214, 0.1);
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  margin-bottom: 4rpx;
}

.dim-v {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: 25rpx;
  color: #1C1C1E;
}

.card-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(60, 60, 67, 0.08);
}

.cite-pills {
  display: flex;
  flex-wrap: wrap;
}

.more-arrow {
  font-size: 25rpx;
  font-weight: 600;
  color: #007AFF;
  white-space: nowrap;
}

.matrix-scroll {
  padding: 0;
  overflow: hidden;
}

.matrix-table {
  display: table;
  width: 2100rpx;
}

.matrix-tr {
  display: flex;
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.12);
}

.matrix-thead {
  background: #1C1C1E;
  color: #FFFFFF;
  font-weight: 600;
}

.matrix-th,
.matrix-td {
  padding: 20rpx;
  font-size: 24rpx;
  border-right: 1rpx solid rgba(60, 60, 67, 0.1);
}

.col-title { width: 320rpx; flex-shrink: 0; }
.col-dim { width: 356rpx; flex-shrink: 0; }

.td-title { display: block; font-weight: 700; margin-bottom: 6rpx; }
.td-meta { font-size: 22rpx; color: #8E8E93; }
.td-page { display: inline-block; margin-left: 8rpx; color: #C96A00; font-weight: 600; }

.empty-card {
  text-align: center;
  padding: 64rpx 36rpx;
}

.empty-emoji {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  display: block;
  font-size: 31rpx;
  font-weight: 700;
  color: #000000;
}

.empty-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #8E8E93;
  line-height: 1.6;
}

/* Floating Frosted Glass Dock */
.frosted-dock {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 20rpx;
  display: flex;
  gap: 12rpx;
  padding: 12rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.86);
  backdrop-filter: blur(22px);
  -webkit-backdrop-filter: blur(22px);
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  z-index: 40;
}

.dock-btn {
  flex: 1;
  margin: 0;
  padding: 12rpx 4rpx;
  border-radius: 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #F2F2F7;
  line-height: 1.2;
  border: none;
}

.dock-btn::after {
  border: none;
}

.dock-excel { background: rgba(52, 199, 89, 0.14); color: #1C7C36; }
.dock-md { background: rgba(28, 28, 30, 0.08); color: #1C1C1E; }
.dock-poster { background: rgba(255, 149, 0, 0.14); color: #C96A00; }
.dock-ai { background: rgba(0, 122, 255, 0.12); color: #0066D6; }
.dock-share { background: rgba(88, 86, 214, 0.12); color: #4B49C8; }

.dock-ico { font-size: 28rpx; }
.dock-txt { font-size: 21rpx; font-weight: 600; margin-top: 4rpx; }

/* Apple Bottom Sheet */
.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.38);
  backdrop-filter: blur(6px);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.sheet-box {
  width: 100%;
  max-height: 82vh;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 16rpx 30rpx calc(32rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

.sheet-grabber {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #D1D1D6;
  margin: 0 auto 20rpx;
}

.sheet-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
}

.sheet-close {
  font-size: 28rpx;
  font-weight: 600;
  color: #007AFF;
  padding: 6rpx 12rpx;
}

.sheet-body {
  max-height: 55vh;
  margin-bottom: 24rpx;
}

.synthesis-text {
  font-size: 26rpx;
  line-height: 1.68;
  color: #1C1C1E;
  white-space: pre-wrap;
}

.sheet-copy {
  width: 100%;
  padding: 20rpx 0;
  line-height: 1.3;
}
