<view class="page-wrap">
  <ios-navbar title="文献综述矩阵">
    <view slot="right" class="nav-user-pill" hover-class="ios-press" bindtap="onTapUserPill">
      <image wx:if="{{user && user.avatarUrl}}" class="nav-avatar" src="{{user.avatarUrl}}" mode="aspectFill" />
      <text class="nav-user-text">{{user ? user.nickName : '登录'}}</text>
    </view>
  </ios-navbar>

  <view class="content">
    <!-- Hero Action Card -->
    <view class="ios-card hero-card ios-enter">
      <view class="hero-top">
        <view>
          <text class="large-title">综述工作台</text>
          <view class="status-meta">
            <view class="dot {{serverOnline ? 'dot-green' : 'dot-amber'}}"></view>
            <text class="meta-txt">{{serverOnline ? '云端引擎就绪' : '未连接后端'}} · {{settings.model}}</text>
          </view>
        </view>
        <view class="count-badge" wx:if="{{papers.length > 0}}">
          <text class="count-num">{{doneCount}}</text>
          <text class="count-sub">/{{papers.length}} 篇</text>
        </view>
      </view>

      <view class="btn-stack">
        <button
          class="ios-btn-primary pick-btn"
          hover-class="ios-press"
          bindtap="onChoosePdfs"
          disabled="{{uploading}}"
        >
          {{uploading ? '正在上传 PDF...' : '📄 从微信聊天选 PDF (1–20 篇)'}}
        </button>
        <view class="secondary-row">
          <button
            class="ios-btn-tinted sec-btn"
            hover-class="ios-press"
            bindtap="onLoadDemo"
            disabled="{{uploading || loadingDemo}}"
          >
            {{loadingDemo ? '加载中...' : '✨ 示例矩阵 (4篇)'}}
          </button>
          <button
            wx:if="{{papers.length > 0}}"
            class="ios-btn-tinted sec-btn btn-danger-tint"
            hover-class="ios-press"
            bindtap="onClearJob"
          >
            清空工作台
          </button>
        </view>
      </view>
    </view>

    <!-- Live Extraction Queue Card -->
    <view class="ios-card progress-card ios-enter ios-enter-delay-1" wx:if="{{papers.length > 0}}">
      <view class="prog-header">
        <text class="prog-label">批量提取进度</text>
        <text class="prog-pct">{{progressPct}}%</text>
      </view>
      <view class="ios-progress-track">
        <view class="ios-progress-fill" style="width: {{progressPct}}%;"></view>
      </view>

      <scroll-view scroll-x="true" class="chips-scroll">
        <view class="chips-row">
          <view
            wx:for="{{papers}}"
            wx:key="id"
            class="file-chip chip-{{item.status}}"
            hover-class="ios-press"
            bindtap="onOpenPaper"
            data-id="{{item.id}}"
          >
            <text class="chip-icon">{{item.status === 'done' ? '✓' : item.status === 'extracting' ? '◌' : item.status === 'error' ? '!' : '•'}}</text>
            <text class="chip-txt">{{item.fileName}}</text>
          </view>
        </view>
      </scroll-view>

      <button
        wx:if="{{errorCount > 0 && !isPolling}}"
        class="ios-btn-tinted retry-btn"
        hover-class="ios-press"
        bindtap="onRetryFailed"
      >
        重试失败论文 ({{errorCount}})
      </button>
    </view>

    <!-- Skeleton Loading Shimmer -->
    <view class="ios-card" wx:if="{{loadingDemo || (isPolling && doneCount === 0)}}">
      <view class="ios-skeleton sk-title"></view>
      <view class="ios-skeleton sk-sub"></view>
      <view class="ios-skeleton sk-line"></view>
      <view class="ios-skeleton sk-line short"></view>
    </view>

    <!-- iOS Animated Segmented Control -->
    <view class="seg-wrap ios-enter ios-enter-delay-2" wx:if="{{doneCount > 0}}">
      <view class="seg-slider {{viewMode === 'table' ? 'seg-right' : ''}}"></view>
      <view class="seg-btn {{viewMode === 'cards' ? 'seg-active' : ''}}" bindtap="setViewMode" data-mode="cards">
        卡片综述 ({{doneCount}})
      </view>
      <view class="seg-btn {{viewMode === 'table' ? 'seg-active' : ''}}" bindtap="setViewMode" data-mode="table">
        横向对比表格
      </view>
    </view>

    <!-- Card View -->
    <view wx:if="{{doneCount > 0 && viewMode === 'cards'}}">
      <view
        wx:for="{{completedPapers}}"
        wx:key="id"
        class="ios-card paper-card ios-enter"
        hover-class="ios-press"
        bindtap="onOpenPaper"
        data-id="{{item.id}}"
      >
        <view class="card-head">
          <text class="paper-title">{{item.extraction.title}}</text>
          <text class="demo-tag" wx:if="{{item.isDemo}}">示例</text>
        </view>
        <text class="paper-meta">{{item.extraction.authors}} · {{item.extraction.year}} · {{item.extraction.venue}}</text>

        <view class="dim-block">
          <view class="dim-item">
            <text class="dim-k">研究问题</text>
            <text class="dim-v">{{item.extraction.research_question.summary}}</text>
          </view>
          <view class="dim-item">
            <text class="dim-k">核心方法</text>
            <text class="dim-v">{{item.extraction.methodology.summary}}</text>
          </view>
          <view class="dim-item">
            <text class="dim-k">核心结论</text>
            <text class="dim-v">{{item.extraction.conclusions.summary}}</text>
          </view>
        </view>

        <view class="card-foot">
          <view class="cite-pills">
            <text class="ios-pill ios-pill-cite" wx:if="{{item.extraction.research_question.citations.length}}">
              问题 P.{{item.extraction.research_question.citations[0].pdf_page}}
            </text>
            <text class="ios-pill ios-pill-cite" wx:if="{{item.extraction.methodology.citations.length}}">
              方法 P.{{item.extraction.methodology.citations[0].pdf_page}}
            </text>
            <text class="ios-pill ios-pill-cite" wx:if="{{item.extraction.conclusions.citations.length}}">
              结论 P.{{item.extraction.conclusions.citations[0].pdf_page}}
            </text>
          </view>
          <text class="more-arrow">5维溯源 ›</text>
        </view>
      </view>
    </view>

    <!-- Horizontal Matrix Table View -->
    <scroll-view scroll-x="true" class="ios-card matrix-scroll" wx:if="{{doneCount > 0 && viewMode === 'table'}}">
      <view class="matrix-table">
        <view class="matrix-tr matrix-thead">
          <view class="matrix-th col-title">论文标题</view>
          <view class="matrix-th col-dim">研究问题</view>
          <view class="matrix-th col-dim">方法</view>
          <view class="matrix-th col-dim">数据集</view>
          <view class="matrix-th col-dim">结论</view>
          <view class="matrix-th col-dim">局限性</view>
        </view>
        <view
          wx:for="{{completedPapers}}"
          wx:key="id"
          class="matrix-tr"
          hover-class="ios-press"
          bindtap="onOpenPaper"
          data-id="{{item.id}}"
        >
          <view class="matrix-td col-title">
            <text class="td-title">{{item.extraction.title}}</text>
            <text class="td-meta">{{item.extraction.authors}} ({{item.extraction.year}})</text>
          </view>
          <view class="matrix-td col-dim">
            <text>{{item.extraction.research_question.summary}}</text>
            <text class="td-page" wx:if="{{item.extraction.research_question.citations.length}}">
              [P.{{item.extraction.research_question.citations[0].pdf_page}}]
            </text>
          </view>
          <view class="matrix-td col-dim">
            <text>{{item.extraction.methodology.summary}}</text>
            <text class="td-page" wx:if="{{item.extraction.methodology.citations.length}}">
              [P.{{item.extraction.methodology.citations[0].pdf_page}}]
            </text>
          </view>
          <view class="matrix-td col-dim">
            <text>{{item.extraction.datasets.summary}}</text>
            <text class="td-page" wx:if="{{item.extraction.datasets.citations.length}}">
              [P.{{item.extraction.datasets.citations[0].pdf_page}}]
            </text>
          </view>
          <view class="matrix-td col-dim">
            <text>{{item.extraction.conclusions.summary}}</text>
            <text class="td-page" wx:if="{{item.extraction.conclusions.citations.length}}">
              [P.{{item.extraction.conclusions.citations[0].pdf_page}}]
            </text>
          </view>
          <view class="matrix-td col-dim">
            <text>{{item.extraction.limitations.summary}}</text>
            <text class="td-page" wx:if="{{item.extraction.limitations.citations.length}}">
              [P.{{item.extraction.limitations.citations[0].pdf_page}}]
            </text>
          </view>
        </view>
      </view>
    </scroll-view>

    <!-- Empty Onboarding Guide -->
    <view class="ios-card empty-card ios-enter ios-enter-delay-1" wx:if="{{papers.length === 0 && !loadingDemo}}">
      <view class="empty-emoji">📚</view>
      <text class="empty-title">把 20 篇 PDF 变成一张综述矩阵</text>
      <text class="empty-desc">
        将论文 PDF 转发给微信「文件传输助手」，点击上方按钮批量勾选，即可自动抽取五维对比表并附带物理页码溯源。
      </text>
    </view>
  </view>

  <!-- Floating Frosted Glass Export Dock -->
  <view class="frosted-dock ios-enter" wx:if="{{doneCount > 0}}">
    <view class="dock-btn dock-excel" hover-class="ios-press" bindtap="onExportExcel">
      <text class="dock-ico">📊</text>
      <text class="dock-txt">Excel</text>
    </view>
    <view class="dock-btn dock-md" hover-class="ios-press" bindtap="onCopyMarkdown">
      <text class="dock-ico">📝</text>
      <text class="dock-txt">Markdown</text>
    </view>
    <view class="dock-btn dock-ai" hover-class="ios-press" bindtap="onSynthesize" wx:if="{{doneCount >= 2}}">
      <text class="dock-ico">✨</text>
      <text class="dock-txt">AI 综述</text>
    </view>
    <button class="dock-btn dock-share" open-type="share" hover-class="ios-press">
      <text class="dock-ico">↗️</text>
      <text class="dock-txt">分享</text>
    </button>
  </view>

  <!-- Spring Bottom Sheet for AI Synthesis -->
  <view class="sheet-mask" wx:if="{{showSynthesis}}" bindtap="closeSynthesis">
    <view class="sheet-box ios-sheet-up" catchtap="noop">
      <view class="sheet-grabber"></view>
      <view class="sheet-head">
        <text class="sheet-title">AI 横向对比综述草稿</text>
        <view class="sheet-close" hover-class="ios-press" bindtap="closeSynthesis">完成</view>
      </view>
      <scroll-view scroll-y="true" class="sheet-body">
        <text selectable="true" class="synthesis-text">{{synthesisText}}</text>
      </scroll-view>
      <button class="ios-btn-primary sheet-copy" hover-class="ios-press" bindtap="copySynthesis">
        一键复制综述段落
      </button>
    </view>
  </view>
</view>
