<view class="settings-page">
  <ios-navbar title="多模型与 API 设置" showBack="{{true}}" />

  <view class="settings-body">
    <view class="ios-section-title">模型服务商（支持国内直连与 Gemini）</view>
    <view class="ios-group ios-enter">
      <picker mode="selector" range="{{providerLabels}}" value="{{providerIndex}}" bindchange="onProviderChange">
        <view class="ios-cell ios-cell-border" hover-class="ios-press">
          <text class="cell-lbl">模型服务商</text>
          <view class="cell-val-row">
            <text class="cell-val">{{providerLabels[providerIndex]}}</text>
            <text class="chevron">›</text>
          </view>
        </view>
      </picker>

      <picker
        wx:if="{{modelLabels.length > 0}}"
        mode="selector"
        range="{{modelLabels}}"
        value="{{modelIndex}}"
        bindchange="onModelChange"
      >
        <view class="ios-cell ios-cell-border" hover-class="ios-press">
          <text class="cell-lbl">提取模型</text>
          <view class="cell-val-row">
            <text class="cell-val">{{modelLabels[modelIndex]}}</text>
            <text class="chevron">›</text>
          </view>
        </view>
      </picker>

      <view wx:else class="ios-cell ios-cell-border field-cell">
        <text class="field-lbl">自定义模型 ID</text>
        <input
          class="field-input"
          value="{{customModel}}"
          bindinput="onCustomModelInput"
          placeholder="例如 gpt-4o-mini"
        />
      </view>

      <view wx:if="{{providerId === 'custom'}}" class="ios-cell ios-cell-border field-cell">
        <text class="field-lbl">Base URL</text>
        <input
          class="field-input"
          value="{{customBaseUrl}}"
          bindinput="onCustomBaseInput"
          placeholder="https://api.siliconflow.cn/v1"
        />
      </view>

      <view class="ios-cell field-cell">
        <text class="field-lbl">API Key</text>
        <input
          class="field-input"
          password="{{true}}"
          value="{{apiKey}}"
          bindinput="onInputKey"
          placeholder="可选，留空则用服务端环境变量"
        />
      </view>
    </view>

    <view class="ios-section-title">服务端与并发策略</view>
    <view class="ios-group ios-enter ios-enter-delay-1">
      <view class="ios-cell ios-cell-border field-cell">
        <text class="field-lbl">后端服务地址</text>
        <input
          class="field-input"
          value="{{serverBaseUrl}}"
          bindinput="onInputServer"
          placeholder="https://api.your-domain.com"
        />
      </view>

      <picker mode="selector" range="{{langLabels}}" value="{{langIndex}}" bindchange="onLangChange">
        <view class="ios-cell ios-cell-border" hover-class="ios-press">
          <text class="cell-lbl">输出语言</text>
          <view class="cell-val-row">
            <text class="cell-val">{{langLabels[langIndex]}}</text>
            <text class="chevron">›</text>
          </view>
        </view>
      </picker>

      <picker mode="selector" range="{{concLabels}}" value="{{concIndex}}" bindchange="onConcChange">
        <view class="ios-cell" hover-class="ios-press">
          <text class="cell-lbl">并发队列数</text>
          <view class="cell-val-row">
            <text class="cell-val">{{concLabels[concIndex]}}</text>
            <text class="chevron">›</text>
          </view>
        </view>
      </picker>
    </view>

    <view class="ios-section-title">自定义附加提取列（除默认五维外）</view>
    <view class="ios-card ios-enter ios-enter-delay-2">
      <view wx:if="{{customDimensions.length > 0}}" class="dim-tags">
        <view wx:for="{{customDimensions}}" wx:key="key" class="custom-row">
          <text class="custom-name">{{item.label}}</text>
          <text class="custom-del" bindtap="removeCustomDim" data-key="{{item.key}}">移除</text>
        </view>
      </view>
      <view class="add-dim-row">
        <input
          class="dim-input"
          value="{{newDimLabel}}"
          bindinput="onDimInput"
          placeholder="例如：开源代码 / 消融实验"
        />
        <button class="ios-btn-tinted add-dim-btn" hover-class="ios-press" bindtap="addCustomDim">
          ＋ 添加
        </button>
      </view>
    </view>

    <button class="ios-btn-primary save-btn ios-enter ios-enter-delay-3" hover-class="ios-press" bindtap="onSave">
      保存全部配置
    </button>
  </view>
</view>
