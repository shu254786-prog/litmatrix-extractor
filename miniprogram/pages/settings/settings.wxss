.container {
  padding: 24rpx;
}

.field {
  margin-bottom: 28rpx;
}

.label {
  display: block;
  font-size: 27rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 10rpx;
}

.input {
  width: 100%;
  height: 76rpx;
  padding: 0 20rpx;
  border: 1rpx solid #cbd5e1;
  border-radius: 12rpx;
  background: #f8fafc;
  font-size: 26rpx;
}

.hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
}

.picker-box {
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 20rpx;
  border: 1rpx solid #cbd5e1;
  border-radius: 12rpx;
  background: #f8fafc;
  font-size: 26rpx;
}

.btn-row {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

.test-btn,
.save-btn {
  flex: 1;
  padding: 16rpx 0;
  line-height: 1.4;
}
