.settings-body {
  padding: 20rpx 24rpx 60rpx;
}

.field-cell {
  gap: 16rpx;
}

.field-lbl {
  width: 190rpx;
  font-size: 27rpx;
  font-weight: 500;
  color: #000000;
  flex-shrink: 0;
}

.field-input {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: #3A3A3C;
}

.cell-lbl {
  font-size: 27rpx;
  font-weight: 500;
  color: #000000;
}

.cell-val-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.cell-val {
  font-size: 26rpx;
  color: #8E8E93;
}

.chevron {
  font-size: 32rpx;
  color: #C7C7CC;
}

.dim-tags {
  margin-bottom: 18rpx;
}

.custom-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 18rpx;
  background: #F2F2F7;
  border-radius: 14rpx;
  margin-bottom: 10rpx;
}

.custom-name {
  font-size: 26rpx;
  font-weight: 600;
}

.custom-del {
  font-size: 24rpx;
  color: #FF3B30;
}

.add-dim-row {
  display: flex;
  gap: 14rpx;
  align-items: center;
}

.dim-input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  background: #F2F2F7;
  font-size: 26rpx;
}

.add-dim-btn {
  margin: 0;
  padding: 14rpx 24rpx;
  line-height: 1.3;
  flex-shrink: 0;
}

.save-btn {
  width: 100%;
  padding: 22rpx 0;
  line-height: 1.3;
  margin-top: 12rpx;
}
