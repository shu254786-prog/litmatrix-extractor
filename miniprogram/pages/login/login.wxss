.login-page {
  min-height: 100vh;
  background: radial-gradient(circle at 50% 0%, rgba(0, 122, 255, 0.12), transparent 52%), #F2F2F7;
}

.login-body {
  padding: 28rpx 32rpx 60rpx;
}

.hero-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 16rpx 0 36rpx;
}

@keyframes floatLogo {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-6rpx); }
}

.logo-ring {
  width: 148rpx;
  height: 148rpx;
  border-radius: 36rpx;
  box-shadow: 0 18rpx 36rpx rgba(0, 122, 255, 0.25);
  animation: floatLogo 4s ease-in-out infinite;
  overflow: hidden;
}

.app-logo {
  width: 148rpx;
  height: 148rpx;
}

.hero-title {
  margin-top: 22rpx;
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: -0.8rpx;
  color: #000000;
}

.hero-sub {
  margin-top: 6rpx;
  font-size: 25rpx;
  color: #8E8E93;
}

.feature-card {
  padding: 24rpx 28rpx;
}

.feat-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 14rpx 0;
}

.feat-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  flex-shrink: 0;
}

.bg-blue { background: rgba(0, 122, 255, 0.12); }
.bg-amber { background: rgba(255, 149, 0, 0.14); }
.bg-green { background: rgba(52, 199, 89, 0.14); }

.feat-info {
  flex: 1;
}

.feat-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #000000;
}

.feat-desc {
  display: block;
  font-size: 23rpx;
  color: #6E6E73;
  margin-top: 2rpx;
}

.auth-card {
  padding: 28rpx;
}

.profile-setup {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-bottom: 26rpx;
}

.avatar-btn {
  width: 108rpx;
  height: 108rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  background: #F2F2F7;
  border: 2rpx dashed #C7C7CC;
  overflow: hidden;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 108rpx;
  height: 108rpx;
}

.avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #8E8E93;
}

.avatar-plus {
  font-size: 32rpx;
  line-height: 1;
}

.avatar-tip {
  font-size: 19rpx;
}

.nickname-wrap {
  flex: 1;
  min-width: 0;
}

.nick-label {
  display: block;
  font-size: 22rpx;
  color: #8E8E93;
  margin-bottom: 8rpx;
}

.nick-input {
  height: 70rpx;
  padding: 0 20rpx;
  border-radius: 14rpx;
  background: #F2F2F7;
  font-size: 27rpx;
  color: #000000;
}

.login-btn {
  width: 100%;
  padding: 22rpx 0;
  line-height: 1.3;
}

.guest-row {
  text-align: center;
  margin-top: 22rpx;
  padding: 8rpx 0;
}

.guest-link {
  font-size: 25rpx;
  color: #007AFF;
  font-weight: 500;
}

.agree-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 10rpx;
}

.checkbox {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  border: 2rpx solid #C7C7CC;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s ease;
}

.checkbox-on {
  background: #007AFF;
  border-color: #007AFF;
}

.check-mark {
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 700;
}

.agree-text {
  font-size: 23rpx;
  color: #8E8E93;
}

.link-text {
  color: #007AFF;
}
