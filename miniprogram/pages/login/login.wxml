<view class="login-page">
  <ios-navbar title="账号登录" showBack="{{canBack}}" />

  <view class="login-body">
    <!-- Hero Brand Block -->
    <view class="hero-section ios-enter">
      <view class="logo-ring">
        <image class="app-logo" src="/assets/icons/app-logo.png" mode="aspectFit" />
      </view>
      <text class="hero-title">LitMatrix</text>
      <text class="hero-sub">文献综述矩阵提取器 · Gemini AI Studio</text>
    </view>

    <!-- Apple-style Feature Highlights -->
    <view class="ios-card feature-card ios-enter ios-enter-delay-1">
      <view class="feat-row">
        <view class="feat-icon bg-blue">📄</view>
        <view class="feat-info">
          <text class="feat-title">批量导入 20+ 篇 PDF</text>
          <text class="feat-desc">从微信聊天记录直选论文，后台异步并发解析不超时</text>
        </view>
      </view>
      <view class="feat-row">
        <view class="feat-icon bg-amber">🔖</view>
        <view class="feat-info">
          <text class="feat-title">五维结构化 + 物理页码溯源</text>
          <text class="feat-desc">研究问题 / 方法 / 数据集 / 结论 / 局限性，附逐字摘录</text>
        </view>
      </view>
      <view class="feat-row">
        <view class="feat-icon bg-green">📊</view>
        <view class="feat-info">
          <text class="feat-title">微信生态无缝导出分享</text>
          <text class="feat-desc">直出 .xlsx 双表、Markdown 及 AI 横向对比综述草稿</text>
        </view>
      </view>
    </view>

    <!-- WeChat Profile & Login Box -->
    <view class="ios-card auth-card ios-enter ios-enter-delay-2">
      <view class="profile-setup">
        <button
          class="avatar-btn"
          open-type="chooseAvatar"
          bindchooseavatar="onChooseAvatar"
          hover-class="ios-press"
        >
          <image
            wx:if="{{avatarUrl}}"
            class="avatar-img"
            src="{{avatarUrl}}"
            mode="aspectFill"
          />
          <view wx:else class="avatar-placeholder">
            <text class="avatar-plus">＋</text>
            <text class="avatar-tip">头像</text>
          </view>
        </button>

        <view class="nickname-wrap">
          <text class="nick-label">科研昵称（可选同步微信昵称）</text>
          <input
            type="nickname"
            class="nick-input"
            value="{{nickName}}"
            bindinput="onNickInput"
            bindchange="onNickInput"
            placeholder="点击填写或一键获取微信昵称"
          />
        </view>
      </view>

      <button
        class="ios-btn-primary login-btn"
        hover-class="ios-press"
        bindtap="onWeChatLogin"
        disabled="{{loggingIn}}"
      >
        {{loggingIn ? '正在安全登录...' : '微信一键登录'}}
      </button>

      <view class="guest-row" hover-class="ios-press" bindtap="onGuestLogin">
        <text class="guest-link">暂不登录，以访客模式体验示例矩阵 ›</text>
      </view>
    </view>

    <!-- Compliance Agreement -->
    <view class="agree-row ios-enter ios-enter-delay-3" bindtap="toggleAgree">
      <view class="checkbox {{agreed ? 'checkbox-on' : ''}}">
        <text wx:if="{{agreed}}" class="check-mark">✓</text>
      </view>
      <view class="agree-text">
        已阅读并同意
        <text class="link-text" catchtap="openPrivacy">《用户服务协议与隐私保护指引》</text>
      </view>
    </view>
  </view>
  <privacy-popup />
</view>
