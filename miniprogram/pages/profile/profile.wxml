<view class="profile-page">
  <ios-navbar title="我的" />

  <view class="profile-body">
    <!-- Apple ID Style User Header Card -->
    <view class="ios-card user-card ios-enter" hover-class="ios-press" bindtap="onTapProfile">
      <image
        wx:if="{{user && user.avatarUrl}}"
        class="avatar"
        src="{{user.avatarUrl}}"
        mode="aspectFill"
      />
      <view wx:else class="avatar-fallback">
        <text>{{user ? '研' : '👤'}}</text>
      </view>
      <view class="user-info">
        <text class="user-name">{{user ? user.nickName : '点击登录微信账号'}}</text>
        <text class="user-sub">
          {{user ? (user.isGuest ? '当前为访客体验模式 · 点击绑定微信' : '微信已登录 · SQLite 云端同步中') : '登录后解锁电脑与手机文献库实时互通'}}
        </text>
      </view>
      <text class="chevron">›</text>
    </view>

    <!-- Apple Handoff PC <-> WeChat Sync Card -->
    <view class="ios-card handoff-card ios-enter ios-enter-delay-1">
      <view class="handoff-top">
        <view>
          <text class="handoff-title">💻 电脑网页端跨端互通 (Handoff)</text>
          <text class="handoff-desc">电脑拖入 20 篇 PDF，手机微信实时同步查看与转发</text>
        </view>
      </view>

      <view class="code-display" wx:if="{{user && user.syncCode}}" bindtap="onCopySyncCode">
        <text class="code-lbl">本机互通码</text>
        <text class="code-val">{{user.syncCode}}</text>
        <text class="code-copy">点击复制</text>
      </view>

      <view class="pair-row">
        <input
          type="number"
          maxlength="6"
          class="pair-input"
          value="{{inputSyncCode}}"
          bindinput="onInputSyncCode"
          placeholder="输入电脑右上角的 6 位互通码"
        />
        <button
          class="ios-btn-primary pair-btn"
          hover-class="ios-press"
          bindtap="onBindSyncCode"
          disabled="{{pairing}}"
        >
          {{pairing ? '连接中' : '立即互通'}}
        </button>
      </view>
    </view>

    <!-- Settings Group 1: AI Engine -->
    <view class="ios-section-title">AI 引擎与模型配置</view>
    <view class="ios-group ios-enter ios-enter-delay-1">
      <view class="ios-cell ios-cell-border" hover-class="ios-press" bindtap="goSettings">
        <view class="cell-left">
          <view class="cell-ico bg-indigo">⚡</view>
          <text class="cell-title">模型与 AI Studio Key</text>
        </view>
        <view class="cell-right">
          <text class="cell-val">{{settings.model}}</text>
          <text class="chevron">›</text>
        </view>
      </view>
      <view class="ios-cell" hover-class="ios-press" bindtap="onTestHealth">
        <view class="cell-left">
          <view class="cell-ico bg-green">📡</view>
          <text class="cell-title">后端服务连通性检测</text>
        </view>
        <view class="cell-right">
          <text class="cell-val">{{serverOnline ? 'SQLite 在线' : '检测'}}</text>
          <text class="chevron">›</text>
        </view>
      </view>
    </view>

    <!-- Settings Group 2: WeChat Ecosystem -->
    <view class="ios-section-title">微信生态与分享</view>
    <view class="ios-group ios-enter ios-enter-delay-2">
      <button class="ios-cell ios-cell-border cell-btn" open-type="share" hover-class="ios-press">
        <view class="cell-left">
          <view class="cell-ico bg-blue">↗️</view>
          <text class="cell-title">推荐 LitMatrix 给科研同门</text>
        </view>
        <text class="chevron">›</text>
      </button>
      <button class="ios-cell ios-cell-border cell-btn" open-type="feedback" hover-class="ios-press">
        <view class="cell-left">
          <view class="cell-ico bg-amber">💬</view>
          <text class="cell-title">意见反馈与异常上报</text>
        </view>
        <text class="chevron">›</text>
      </button>
      <button class="ios-cell cell-btn" open-type="contact" hover-class="ios-press">
        <view class="cell-left">
          <view class="cell-ico bg-teal">🎧</view>
          <text class="cell-title">联系客服与合作</text>
        </view>
        <text class="chevron">›</text>
      </button>
    </view>

    <!-- Settings Group 3: Compliance & Cache -->
    <view class="ios-section-title">隐私与系统</view>
    <view class="ios-group ios-enter ios-enter-delay-3">
      <view class="ios-cell ios-cell-border" hover-class="ios-press" bindtap="goPrivacy">
        <view class="cell-left">
          <view class="cell-ico bg-gray">🛡️</view>
          <text class="cell-title">用户协议与隐私保护指引</text>
        </view>
        <text class="chevron">›</text>
      </view>
      <view class="ios-cell" hover-class="ios-press" bindtap="onClearCache">
        <view class="cell-left">
          <view class="cell-ico bg-red">🧹</view>
          <text class="cell-title">清理本地缓存</text>
        </view>
        <text class="chevron">›</text>
      </view>
    </view>

    <button
      wx:if="{{user}}"
      class="ios-btn-tinted logout-btn ios-enter ios-enter-delay-3"
      hover-class="ios-press"
      bindtap="onLogout"
    >
      退出当前登录
    </button>
  </view>
</view>
