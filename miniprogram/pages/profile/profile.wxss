.profile-body {
  padding: 20rpx 24rpx 60rpx;
}

.user-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 28rpx;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.avatar-fallback {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #007AFF, #5856D6);
  color: #FFFFFF;
  font-size: 42rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-name {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #000000;
}

.user-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #8E8E93;
}

.cell-btn {
  width: 100%;
  text-align: left;
  border-radius: 0;
  margin: 0;
  font-weight: 400;
  line-height: 1.48;
}

.cell-btn::after {
  border: none;
}

.cell-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.cell-ico {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.bg-indigo { background: rgba(88, 86, 214, 0.12); }
.bg-green { background: rgba(52, 199, 89, 0.14); }
.bg-blue { background: rgba(0, 122, 255, 0.12); }
.bg-amber { background: rgba(255, 149, 0, 0.14); }
.bg-teal { background: rgba(48, 176, 199, 0.14); }
.bg-gray { background: rgba(142, 142, 147, 0.14); }
.bg-red { background: rgba(255, 59, 48, 0.12); }

.cell-title {
  font-size: 28rpx;
  color: #000000;
  font-weight: 500;
}

.cell-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.cell-val {
  font-size: 25rpx;
  color: #8E8E93;
  max-width: 240rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chevron {
  font-size: 34rpx;
  color: #C7C7CC;
  line-height: 1;
}

.logout-btn {
  width: 100%;
  padding: 22rpx 0;
  background: #FFFFFF;
  color: #FF3B30;
  border-radius: 22rpx;
  line-height: 1.3;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
}
