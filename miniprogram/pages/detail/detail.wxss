.detail-body {
  padding: 20rpx 24rpx 60rpx;
}

.paper-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #000000;
  line-height: 1.35;
}

.paper-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #007AFF;
  font-weight: 500;
}

.file-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 14rpx;
}

.file-name {
  flex: 1;
  font-size: 22rpx;
  color: #8E8E93;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.open-pdf-btn {
  margin-top: 20rpx;
  width: 100%;
  padding: 16rpx 0;
  line-height: 1.3;
}

.sec-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.sec-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.sec-bar {
  width: 8rpx;
  height: 30rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #007AFF, #5856D6);
}

.sec-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #000000;
}

.edit-pill {
  font-size: 22rpx;
  font-weight: 600;
  color: #007AFF;
  background: rgba(0, 122, 255, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.kw-row {
  margin-bottom: 10rpx;
}

.sec-summary {
  display: block;
  font-size: 27rpx;
  line-height: 1.68;
  color: #1C1C1E;
}

.cite-list {
  margin-top: 20rpx;
}

.cite-card {
  background: #FFF9EB;
  border: 1rpx solid rgba(255, 149, 0, 0.28);
  border-radius: 18rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 12rpx;
}

.cite-top {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.cite-sec {
  font-size: 23rpx;
  color: #7D4E00;
  font-weight: 600;
  flex: 1;
}

.copy-hint {
  font-size: 21rpx;
  color: #C96A00;
}

.cite-quote {
  display: block;
  font-size: 24rpx;
  color: #3A3A3C;
  font-style: italic;
  line-height: 1.55;
}

.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.38);
  backdrop-filter: blur(6px);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.sheet-box {
  width: 100%;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 16rpx 30rpx calc(36rpx + env(safe-area-inset-bottom));
}

.sheet-grabber {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #D1D1D6;
  margin: 0 auto 20rpx;
}

.sheet-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.sheet-title {
  font-size: 31rpx;
  font-weight: 700;
}

.sheet-cancel {
  font-size: 27rpx;
  color: #8E8E93;
  padding: 6rpx 10rpx;
}

.edit-area {
  width: 100%;
  height: 260rpx;
  background: #F2F2F7;
  border-radius: 18rpx;
  padding: 20rpx;
  font-size: 27rpx;
  line-height: 1.6;
  color: #000000;
  margin-bottom: 24rpx;
}

.save-edit-btn {
  width: 100%;
  padding: 20rpx 0;
  line-height: 1.3;
}
