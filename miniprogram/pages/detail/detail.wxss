.container {
  padding: 24rpx;
}

.paper-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}

.paper-sub {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: #4f46e5;
  font-weight: 500;
}

.paper-file {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
  word-break: break-all;
}

.sec-head {
  margin-bottom: 14rpx;
}

.sec-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
  border-left: 8rpx solid #4f46e5;
  padding-left: 14rpx;
}

.kw-row {
  margin-bottom: 12rpx;
}

.sec-summary {
  display: block;
  font-size: 27rpx;
  line-height: 1.65;
  color: #1e293b;
}

.cite-list {
  margin-top: 18rpx;
}

.cite-box {
  background: #fffbeb;
  border: 1rpx solid #fde68a;
  border-radius: 14rpx;
  padding: 16rpx 18rpx;
  margin-bottom: 12rpx;
}

.cite-top {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.cite-sec {
  font-size: 22rpx;
  color: #78350f;
  font-weight: 600;
  flex: 1;
}

.copy-hint {
  font-size: 20rpx;
  color: #b45309;
}

.cite-quote {
  display: block;
  font-size: 24rpx;
  color: #334155;
  font-style: italic;
  line-height: 1.5;
}
