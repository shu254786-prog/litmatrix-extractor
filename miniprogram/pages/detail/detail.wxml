<view class="detail-page" wx:if="{{paper}}">
  <ios-navbar title="五维溯源详情" showBack="{{true}}" />

  <view class="detail-body">
    <!-- Paper Header Card -->
    <view class="ios-card meta-card ios-enter">
      <text class="paper-title">{{paper.extraction.title}}</text>
      <text class="paper-sub">
        {{paper.extraction.authors}} · {{paper.extraction.year}} · {{paper.extraction.venue}}
      </text>
      <view class="file-row">
        <text class="ios-pill">PDF 共 {{paper.pageCount || paper.extraction.total_pages_detected}} 页</text>
        <text class="file-name">{{paper.fileName}}</text>
      </view>
      <button
        wx:if="{{paper.hasPdf}}"
        class="ios-btn-tinted open-pdf-btn"
        hover-class="ios-press"
        bindtap="onOpenOriginalPdf"
      >
        📄 打开原论文 PDF 对照阅读 / 转发
      </button>
    </view>

    <!-- Five Dimension Cards -->
    <view
      wx:for="{{sections}}"
      wx:key="key"
      class="ios-card sec-card ios-enter"
    >
      <view class="sec-head">
        <view class="sec-title-wrap">
          <view class="sec-bar"></view>
          <text class="sec-title">{{item.label}}</text>
        </view>
        <view
          class="edit-pill"
          hover-class="ios-press"
          bindtap="openEditor"
          data-key="{{item.key}}"
          data-label="{{item.label}}"
          data-summary="{{item.data.summary}}"
        >
          微调文本
        </view>
      </view>

      <view class="kw-row" wx:if="{{item.data.keywords.length}}">
        <text wx:for="{{item.data.keywords}}" wx:for-item="kw" wx:key="*this" class="ios-pill">
          {{kw}}
        </text>
      </view>

      <text selectable="true" class="sec-summary">{{item.data.summary}}</text>

      <!-- Page Provenance Evidence Cards -->
      <view class="cite-list" wx:if="{{item.data.citations.length}}">
        <view
          wx:for="{{item.data.citations}}"
          wx:for-item="cit"
          wx:key="index"
          class="cite-card"
          hover-class="ios-press"
          bindtap="onTapCitation"
          data-quote="{{cit.quote}}"
          data-section="{{cit.section}}"
          data-page="{{cit.pdf_page}}"
        >
          <view class="cite-top">
            <text class="ios-pill ios-pill-cite">PDF P.{{cit.pdf_page}}</text>
            <text class="cite-sec">{{cit.section || '正文'}}</text>
            <text class="copy-hint">{{paper.hasPdf ? '查看原页高亮图 ›' : '轻点复制摘录'}}</text>
          </view>
          <text class="cite-quote">“{{cit.quote}}”</text>
          <view class="cite-sub-actions" wx:if="{{paper.hasPdf}}" catchtap="onCopyQuote" data-quote="{{cit.quote}}" data-page="{{cit.pdf_page}}">
            <text class="copy-pill">📋 复制原文</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- HD PDF Page Provenance Lightbox -->
  <view class="sheet-mask" wx:if="{{pageViewer}}" bindtap="closePageViewer">
    <view class="viewer-sheet ios-sheet-up" catchtap="noop">
      <view class="sheet-grabber"></view>
      <view class="sheet-head">
        <view class="viewer-title-row">
          <text class="ios-pill ios-pill-cite">第 {{pageViewer.page}} 页</text>
          <text class="sheet-title">PDF 原页高清溯源</text>
        </view>
        <text class="viewer-done" bindtap="closePageViewer">完成</text>
      </view>

      <view class="viewer-quote-banner" wx:if="{{pageViewer.quote}}">
        <text class="vq-sec">{{pageViewer.section || '原文摘录'}}：</text>
        <text class="vq-txt">“{{pageViewer.quote}}”</text>
      </view>

      <scroll-view scroll-y="true" class="viewer-scroll">
        <view wx:if="{{pageViewer.loading}}" class="viewer-loading">
          <view class="ios-skeleton sk-page"></view>
          <text class="vl-txt">正在渲染第 {{pageViewer.page}} 页高清图并高亮原文...</text>
        </view>
        <image
          wx:elif="{{pageViewer.imagePath}}"
          src="{{pageViewer.imagePath}}"
          mode="widthFix"
          class="viewer-img"
          bindtap="onZoomPageImage"
        />
      </scroll-view>

      <view class="viewer-toolbar">
        <button
          class="ios-btn-tinted nav-pg-btn"
          hover-class="ios-press"
          disabled="{{pageViewer.page <= 1 || pageViewer.loading}}"
          bindtap="onPrevPage"
        >
          ‹ 上一页
        </button>
        <text class="pg-counter">{{pageViewer.page}} / {{pageViewer.totalPages}}</text>
        <button
          class="ios-btn-tinted nav-pg-btn"
          hover-class="ios-press"
          disabled="{{pageViewer.page >= pageViewer.totalPages || pageViewer.loading}}"
          bindtap="onNextPage"
        >
          下一页 ›
        </button>
        <button
          class="ios-btn-primary zoom-btn"
          hover-class="ios-press"
          wx:if="{{pageViewer.imagePath}}"
          bindtap="onZoomPageImage"
        >
          🔍 放大
        </button>
      </view>
    </view>
  </view>

  <!-- Inline Edit Bottom Sheet -->
  <view class="sheet-mask" wx:if="{{editing}}" bindtap="closeEditor">
    <view class="sheet-box ios-sheet-up" catchtap="noop">
      <view class="sheet-grabber"></view>
      <view class="sheet-head">
        <text class="sheet-title">微调「{{editing.label}}」</text>
        <text class="sheet-cancel" bindtap="closeEditor">取消</text>
      </view>
      <textarea
        class="edit-area"
        value="{{editing.value}}"
        bindinput="onEditInput"
        maxlength="1200"
        auto-height="{{false}}"
      />
      <button class="ios-btn-primary save-edit-btn" hover-class="ios-press" bindtap="saveEdit">
        保存修改并同步矩阵
      </button>
    </view>
  </view>
</view>
