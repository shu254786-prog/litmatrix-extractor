<view class="detail-page" wx:if="{{paper}}">
  <ios-navbar title="五维溯源详情" showBack="{{true}}" />

  <view class="detail-body">
    <!-- Paper Header Card -->
    <view class="ios-card meta-card ios-enter">
      <text class="paper-title">{{paper.extraction.title}}</text>
      <text class="paper-sub">
        {{paper.extraction.authors}} · {{paper.extraction.year}} · {{paper.extraction.venue}}
      </text>
      <view class="file-row">
        <text class="ios-pill">PDF 共 {{paper.pageCount || paper.extraction.total_pages_detected}} 页</text>
        <text class="file-name">{{paper.fileName}}</text>
      </view>
    </view>

    <!-- Five Dimension Cards -->
    <view
      wx:for="{{sections}}"
      wx:key="key"
      class="ios-card sec-card ios-enter"
    >
      <view class="sec-head">
        <view class="sec-title-wrap">
          <view class="sec-bar"></view>
          <text class="sec-title">{{item.label}}</text>
        </view>
        <view
          class="edit-pill"
          hover-class="ios-press"
          bindtap="openEditor"
          data-key="{{item.key}}"
          data-label="{{item.label}}"
          data-summary="{{item.data.summary}}"
        >
          微调文本
        </view>
      </view>

      <view class="kw-row" wx:if="{{item.data.keywords.length}}">
        <text wx:for="{{item.data.keywords}}" wx:for-item="kw" wx:key="*this" class="ios-pill">
          {{kw}}
        </text>
      </view>

      <text selectable="true" class="sec-summary">{{item.data.summary}}</text>

      <!-- Page Provenance Evidence Cards -->
      <view class="cite-list" wx:if="{{item.data.citations.length}}">
        <view
          wx:for="{{item.data.citations}}"
          wx:for-item="cit"
          wx:key="index"
          class="cite-card"
          hover-class="ios-press"
          bindtap="onCopyQuote"
          data-quote="{{cit.quote}}"
          data-page="{{cit.pdf_page}}"
        >
          <view class="cite-top">
            <text class="ios-pill ios-pill-cite">PDF P.{{cit.pdf_page}}</text>
            <text class="cite-sec">{{cit.section || '正文'}}</text>
            <text class="copy-hint">轻点复制</text>
          </view>
          <text class="cite-quote">“{{cit.quote}}”</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Inline Edit Bottom Sheet -->
  <view class="sheet-mask" wx:if="{{editing}}" bindtap="closeEditor">
    <view class="sheet-box ios-sheet-up" catchtap="noop">
      <view class="sheet-grabber"></view>
      <view class="sheet-head">
        <text class="sheet-title">微调「{{editing.label}}」</text>
        <text class="sheet-cancel" bindtap="closeEditor">取消</text>
      </view>
      <textarea
        class="edit-area"
        value="{{editing.value}}"
        bindinput="onEditInput"
        maxlength="1200"
        auto-height="{{false}}"
      />
      <button class="ios-btn-primary save-edit-btn" hover-class="ios-press" bindtap="saveEdit">
        保存修改并同步矩阵
      </button>
    </view>
  </view>
</view>
