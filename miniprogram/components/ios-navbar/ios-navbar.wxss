.ios-nav-fixed {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 90;
  background: rgba(242, 242, 247, 0.82);
  backdrop-filter: blur(22px);
  -webkit-backdrop-filter: blur(22px);
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.1);
}

.ios-nav-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 24rpx;
}

.ios-nav-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.ios-brand-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #007AFF, #5856D6);
  flex-shrink: 0;
}

.ios-nav-title {
  font-size: 33rpx;
  font-weight: 700;
  color: #000000;
  letter-spacing: -0.4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ios-back-btn {
  display: inline-flex;
  align-items: center;
  color: #007AFF;
  padding: 6rpx 12rpx 6rpx 0;
  margin-left: -4rpx;
}

.ios-chevron {
  font-size: 46rpx;
  line-height: 1;
  font-weight: 300;
  margin-right: 4rpx;
  margin-top: -4rpx;
}

.ios-back-text {
  font-size: 30rpx;
  font-weight: 500;
}
