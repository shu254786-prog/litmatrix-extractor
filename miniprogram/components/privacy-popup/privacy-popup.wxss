.privacy-mask {
  position: fixed;
  inset: 0;
  z-index: 200;
  background: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.privacy-dialog {
  width: 100%;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 28rpx;
  padding: 36rpx 32rpx 28rpx;
  text-align: center;
  box-shadow: 0 24rpx 48rpx rgba(0, 0, 0, 0.18);
}

.privacy-badge {
  font-size: 52rpx;
  margin-bottom: 12rpx;
}

.privacy-title {
  display: block;
  font-size: 33rpx;
  font-weight: 700;
  color: #000000;
}

.privacy-desc {
  display: block;
  margin-top: 16rpx;
  font-size: 25rpx;
  line-height: 1.62;
  color: #3A3A3C;
  text-align: left;
}

.privacy-link {
  color: #007AFF;
  font-weight: 600;
}

.privacy-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 30rpx;
}

.priv-btn {
  flex: 1;
  margin: 0;
  padding: 18rpx 0;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.3;
  border: none;
}

.priv-btn::after {
  border: none;
}

.priv-disagree {
  background: #F2F2F7;
  color: #3A3A3C;
}

.priv-agree {
  background: #007AFF;
  color: #FFFFFF;
}
